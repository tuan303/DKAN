# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Microsoft Graph API Settings (for Email)
# Users must configure these via the Secrets panel in the AI Studio UI
MS_GRAPH_TENANT_ID="your_tenant_id_here"
MS_GRAPH_CLIENT_ID="your_client_id_here"
MS_GRAPH_CLIENT_SECRET="your_client_secret_here"
MS_GRAPH_SENDER="dinhduong@hoangmaistarschool.edu.vn"

# Email cảnh báo chấm ăn (POST /api/meal-alerts) — agent đồng bộ trên máy HAC gọi vào sau giờ ăn trưa.
# MEAL_ALERT_SECRET: khoá bí mật dùng chung với agent (alerts.secret trong agent/config.json), tối thiểu 32 ký tự,
# chỉ dùng ký tự ASCII (chữ không dấu, chữ số, ký hiệu), KHÔNG có dấu cách. Thiếu, ngắn hơn 32 ký tự hoặc sai ký tự thì
# endpoint luôn từ chối (500) — không bao giờ chạy ở chế độ "không cần khoá".
# Tạo khoá ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MEAL_ALERT_SECRET=""
# MEAL_ALERT_CC: địa chỉ nhận bản CC của mọi email cảnh báo, đồng thời là địa chỉ nhận thư trả lời (khiếu nại) của CBNV.
# Không khai báo biến này thì mặc định là dinhduong@hoangmaistarschool.edu.vn.
# Đặt chuỗi rỗng (hoặc "none") thì không CC ai, thư trả lời sẽ về hộp thư gửi MS_GRAPH_SENDER.
# Có thể ghi nhiều địa chỉ, cách nhau bằng dấu phẩy. Mọi địa chỉ phải là @hoangmaistarschool.edu.vn, không kèm
# dấu ngoặc kép hay tên hiển thị; ghi sai thì endpoint báo 500 "cấu hình sai MEAL_ALERT_CC" và không gửi thư nào.
MEAL_ALERT_CC="dinhduong@hoangmaistarschool.edu.vn"
# MEAL_ALERT_ADMINS: những ai được nhận email báo quản trị khi agent tự dừng gửi cảnh báo (chốt an toàn).
# Phải chứa mọi địa chỉ khai trong alerts.adminEmails của agent; địa chỉ agent gửi lên mà không có ở đây sẽ bị bỏ
# (không gửi). Danh sách nằm ở máy chủ để dù khoá bị lộ cũng không gửi được thư báo quản trị tới người khác.
# Không khai báo thì chỉ gửi được tới các địa chỉ trong MEAL_ALERT_CC và hộp thư gửi MS_GRAPH_SENDER.
# Cách nhau bằng dấu phẩy, chỉ nhận địa chỉ @hoangmaistarschool.edu.vn.
MEAL_ALERT_ADMINS="dinhduong@hoangmaistarschool.edu.vn,tuantm@hoangmaistarschool.edu.vn"
# PUBLIC_APP_URL: địa chỉ trang web, dùng để dựng link "Xem lịch sử chấm ăn" (PUBLIC_APP_URL/cham-an) trong email.
# Không có dấu "/" ở cuối. Mặc định https://dkan.nshm.vn
PUBLIC_APP_URL="https://dkan.nshm.vn"
